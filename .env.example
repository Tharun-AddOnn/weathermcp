# Transport ------------------------------------------------------------------
# Only used with --http. Most platforms inject PORT instead.
WEATHER_HTTP_PORT=3000

# How long to wait for a human to answer an elicitation prompt, in seconds.
WEATHER_TIMEOUT_SECONDS=300

# Fallback when the client cannot render elicitation ---------------------------
#   browser        serve a local form page and open it (local/stdio use)
#   conversational return status "input_required" and let the model ask in chat
# Defaults: browser for stdio, conversational for --http.
WEATHER_FALLBACK=conversational

# Never auto-open a browser on a server. Always set this for hosted deployments.
WEATHER_NO_LAUNCH=1

# Public origin, used to build fallback prompt links. Must match how users
# reach the server, or those links will 404.
WEATHER_PUBLIC_URL=https://your-host.example.com

# Auth (pick one for any publicly reachable deployment) -----------------------
# Bearer token: strongest, and what the Claude Messages API sends.
# WEATHER_AUTH_TOKEN=generate-with-openssl-rand-hex-32
# URL path secret: for connector UIs that cannot send a header. Endpoint becomes
# /mcp/<secret>. Weaker - URLs leak into logs and history.
# WEATHER_PATH_SECRET=generate-with-openssl-rand-hex-16

# Extend the city list without touching code: JSON array of {id,label,country}.
# WEATHER_CITIES_FILE=./cities.json

# Testing aid: pin the prompt channel.
# elicitation-form | elicitation-url | browser | conversational
# WEATHER_FORCE_CHANNEL=conversational
