{
  "name": "mcp-weather-elicitation",
  "version": "1.0.0",
  "description": "MCP server POC demonstrating interactive elicitation: asks the user for city and temperature unit through the AI client's own UI, then runs get_weather.",
  "type": "module",
  "bin": {
    "mcp-weather": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "start:http": "node dist/index.js --http"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@netlify/blobs": "^11.0.2",
    "express": "^5.1.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elicitation",
    "weather",
    "claude",
    "chatgpt",
    "copilot"
  ]
}
